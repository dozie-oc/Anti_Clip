# AntiClip Configuration

# Server
APP_NAME=AntiClip
HOST=0.0.0.0
PORT=8000
DEBUG=True

# LLM Providers (Priority: OpenAI > Ollama > Fallback)
# OPENAI_API_KEY=your_key_here
LLM_MODEL_NAME=gpt-4o

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_CPU_ONLY=False

# Whisper (Transcription)
WHISPER_MODEL=base
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# TTS (Narration Mode)
PIPER_VOICE=en_US-lessac-medium
PIPER_MODELS_DIR=storage/models/piper
